{% extends "govuk/template.njk" %}

{% from "govuk/components/header/macro.njk" import govukHeader %}
{% from "govuk/components/phase-banner/macro.njk" import govukPhaseBanner %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "moj/components/primary-navigation/macro.njk" import mojPrimaryNavigation %}

{% block head %}
  <link href="/public/stylesheets/application.css" rel="stylesheet">
{% endblock %}

{% block pageTitle %}
Manage linked cases
{% endblock %}

{% block header %}
  {{ govukHeader({
    homepageUrl: "#",
    productName: "Legal Aid Agency",
    navigationClasses: "govuk-header__navigation--end",
    navigation: [
      { href: "#", text: "joann.barton@law.com" },
      { href: "/v6-v3/sign-out", text: "Sign out" }
    ]
  }) }}

  {{ mojPrimaryNavigation({
    label: "Primary navigation",
    items: [
      { text: "Decide if an applicant can get legal aid", href: "#" },
      { text: "Open applications", href: "/v6-v3/open-applications" },
      { text: "Your list", href: "/v6-v3/yourlist" },
      { text: "Search", href: "/v6-v3/search" }
    ]
  }) }}
{% endblock %}

{% block beforeContent %}
  {{ govukPhaseBanner({
    tag: { text: "Beta" },
    html: "This is a new service - your <a class=\"govuk-link\" href=\"#\">feedback</a> will help us to improve it."
  }) }}
  {{ govukBackLink({
    text: "Back",
    href: "/v6-v3/application/" ~ reference
  }) }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <h1 class="govuk-heading-xl">Manage linked cases</h1>

      <a href="/v6-v3/manage-linked-cases/{{ reference }}?add=true" role="button" draggable="false" class="govuk-button govuk-!-margin-bottom-6">Link to this case</a>

      {% if leadCase %}
        <table class="govuk-table govuk-!-margin-bottom-6">
          <caption class="govuk-table__caption govuk-table__caption--m govuk-!-padding-3" style="background-color: #f3f2f1; border: 1px solid #b1b4b6; border-bottom: 0;">Lead</caption>
          <thead class="govuk-table__head">
            <tr class="govuk-table__row">
              <th scope="col" class="govuk-table__header">Reference</th>
              <th scope="col" class="govuk-table__header">First name</th>
              <th scope="col" class="govuk-table__header">Last name</th>
              <th scope="col" class="govuk-table__header">Date of birth</th>
              <th scope="col" class="govuk-table__header">Submitted</th>
              <th scope="col" class="govuk-table__header">Firm name &amp;<br>number</th>
              <th scope="col" class="govuk-table__header">Action</th>
            </tr>
          </thead>
          <tbody class="govuk-table__body">
            <tr class="govuk-table__row">
              <td class="govuk-table__cell"><a href="/v6-v3/application/{{ leadCase.reference }}" class="govuk-link">{{ leadCase.reference }}</a></td>
              <td class="govuk-table__cell">{{ leadCase.firstName }}</td>
              <td class="govuk-table__cell">{{ leadCase.lastName }}</td>
              <td class="govuk-table__cell">{{ leadCase.dob }}</td>
              <td class="govuk-table__cell">{{ leadCase.submitted }}</td>
              <td class="govuk-table__cell">{{ leadCase.firm | safe }}</td>
              <td class="govuk-table__cell" style="white-space: nowrap;"><a href="#" class="govuk-link">Unlink</a>&nbsp;&nbsp;<a href="#" class="govuk-link">Change lead</a></td>
            </tr>
          </tbody>
        </table>
      {% endif %}

      {% if associatedCases and associatedCases.length > 0 %}
        <table class="govuk-table govuk-!-margin-bottom-6">
          <caption class="govuk-table__caption govuk-table__caption--m govuk-!-padding-3" style="background-color: #f3f2f1; border: 1px solid #b1b4b6; border-bottom: 0;">Associated</caption>
          <thead class="govuk-table__head">
            <tr class="govuk-table__row">
              <th scope="col" class="govuk-table__header">Reference</th>
              <th scope="col" class="govuk-table__header">First name</th>
              <th scope="col" class="govuk-table__header">Last name</th>
              <th scope="col" class="govuk-table__header">Date of birth</th>
              <th scope="col" class="govuk-table__header">Submitted</th>
              <th scope="col" class="govuk-table__header">Action</th>
            </tr>
          </thead>
          <tbody class="govuk-table__body">
            {% for linkedCase in associatedCases %}
              <tr class="govuk-table__row">
                <td class="govuk-table__cell"><a href="/v6-v3/application/{{ linkedCase.reference }}" class="govuk-link">{{ linkedCase.reference }}</a></td>
                <td class="govuk-table__cell">{{ linkedCase.firstName }}</td>
                <td class="govuk-table__cell">{{ linkedCase.lastName }}</td>
                <td class="govuk-table__cell">{{ linkedCase.dob }}</td>
                <td class="govuk-table__cell">{{ linkedCase.submitted }}</td>
                <td class="govuk-table__cell"><a href="/v6-v3/manage-linked-cases/{{ reference }}/unlink/{{ linkedCase.reference }}" class="govuk-link">Unlink case</a></td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      {% endif %}

      {% if showLinkForm and candidates and candidates.length > 0 %}
        <form action="/v6-v3/manage-linked-cases/{{ reference }}" method="post">
          <fieldset class="govuk-fieldset">
            <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">Choose a standalone application to link</legend>
            <div class="govuk-radios" data-module="govuk-radios">
              {% for candidate in candidates %}
                <div class="govuk-radios__item">
                  <input class="govuk-radios__input" id="new-linked-reference-{{ loop.index }}" name="new-linked-reference" type="radio" value="{{ candidate.reference }}">
                  <label class="govuk-label govuk-radios__label" for="new-linked-reference-{{ loop.index }}">
                    {{ candidate.reference }} - {{ candidate.firstName }} {{ candidate.lastName }}
                  </label>
                  <div class="govuk-hint govuk-radios__hint">Submitted {{ candidate.submitted }}</div>
                </div>
              {% endfor %}
            </div>
          </fieldset>
          {{ govukButton({ text: "Assign and add new link" }) }}
        </form>
      {% elif showLinkForm %}
        <p class="govuk-body">There are no standalone applications available to link.</p>
      {% endif %}
    </div>
  </div>
{% endblock %}

{% block bodyEnd %}
  <script src="/plugin-assets/govuk-prototype-kit/lib/assets/javascripts/kit.js"></script>
  <script src="/plugin-assets/govuk-prototype-kit/lib/assets/javascripts/auto-store-data.js"></script>
  <script type="module" src="/plugin-assets/govuk-frontend/dist/govuk/govuk-frontend.min.js"></script>
  <script type="module" src="/plugin-assets/govuk-frontend/dist/govuk-prototype-kit/init.js"></script>
{% endblock %}
