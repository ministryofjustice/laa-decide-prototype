{% extends "govuk/template.njk" %}

{% from "govuk/components/header/macro.njk" import govukHeader %}
{% from "govuk/components/phase-banner/macro.njk" import govukPhaseBanner %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "moj/components/primary-navigation/macro.njk" import mojPrimaryNavigation %}

{% block head %}
  <link href="/public/stylesheets/application.css" rel="stylesheet">
  <style>
    .v3-confirmation-screen { box-sizing: border-box; margin-bottom: 32px; padding: 30px; color: #fff; text-align: center; background-color: #00703c; font-family: "GDS Transport", Arial, sans-serif; }
    .v3-confirmation-screen h1 { margin: 0 0 7vh; color: #fff; font-size: clamp(2.5rem, 6vw, 5.5rem); line-height: 1.1; }
    .v3-confirmation-screen p { margin: 0; color: #fff; font-size: clamp(2rem, 5vw, 4.25rem); line-height: 1.2; }
    .v3-confirmation-screen .v3-confirmation-reference { margin-top: 1vh; font-weight: 400; }
  </style>
{% endblock %}
{% block pageTitle %}Confirmation{% endblock %}

{% block header %}
  {{ govukHeader({ homepageUrl: "#", productName: "Legal Aid Agency", navigationClasses: "govuk-header__navigation--end", navigation: [{ href: "#", text: "joann.barton@law.com" }, { href: "/v6-v3/sign-out", text: "Sign out" }] }) }}
  {{ mojPrimaryNavigation({ label: "Primary navigation", items: [{ text: "Decide if an applicant can get legal aid", href: "#" }, { text: "Open applications", href: "/v6-v3/open-applications" }, { text: "Your list", href: "/v6-v3/yourlist" }, { text: "Search", href: "/v6-v3/search" }] }) }}
{% endblock %}

{% block beforeContent %}
  {{ govukPhaseBanner({ tag: { text: "Beta" }, html: "This is a new service - your <a class=\"govuk-link\" href=\"#\">feedback</a> will help us to improve it." }) }}
  {{ govukBackLink({ text: "Back to open applications", href: "/v6-v3/open-applications" }) }}
{% endblock %}

{% block content %}
  <section class="v3-confirmation-screen">
    <h1>Assessment complete</h1>
    <p>Reference number:</p>
    <p class="v3-confirmation-reference">{{ reference }}</p>
  </section>
  <div class="govuk-grid-row"><div class="govuk-grid-column-two-thirds">
    <h2 class="govuk-heading-m">What happens next</h2>
    <p class="govuk-body">We've saved your decision and it has been sent to the provider.</p>
    {{ govukButton({ text: "View your list", href: "/v6-v3/yourlist" }) }}
  </div></div>
{% endblock %}

{% block bodyEnd %}
  <script src="/plugin-assets/govuk-prototype-kit/lib/assets/javascripts/kit.js"></script>
  <script src="/plugin-assets/govuk-prototype-kit/lib/assets/javascripts/auto-store-data.js"></script>
  <script type="module" src="/plugin-assets/govuk-frontend/dist/govuk/govuk-frontend.min.js"></script>
  <script type="module" src="/plugin-assets/govuk-frontend/dist/govuk-prototype-kit/init.js"></script>
{% endblock %}
