{% extends "layouts/main.html" %}

{% block pageTitle %}{{ document.title }} - M-MDDT-WBYS{% endblock %}

{% block beforeContent %}
  <a class="govuk-back-link" href="/v6-v5/application/M-MDDT-WBYS?isRedetermination=true">Back to application</a>
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <span class="govuk-caption-l">M-MDDT-WBYS</span>
      <h1 class="govuk-heading-xl">{{ document.title }}</h1>
      <p class="govuk-body">Date: {{ document.date }}</p>
      <div class="govuk-inset-text">Mock document for user research. This is not a real application or legal advice.</div>
      {% for paragraph in document.paragraphs %}
        <p class="govuk-body">{{ paragraph }}</p>
      {% endfor %}
    </div>
  </div>
{% endblock %}
