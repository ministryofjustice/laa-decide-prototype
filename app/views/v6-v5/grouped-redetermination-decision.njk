{% extends "v6-v5/redetermination-decision.njk" %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/date-input/macro.njk" import govukDateInput %}
{% from "govuk/components/textarea/macro.njk" import govukTextarea %}

{% block head %}
  {{ super() }}
  <style>
    .redetermination-proceeding-heading {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
    }
    .redetermination-edit-button {
      border: 0;
      padding: 0;
      background: none;
      color: #1d70b8;
      cursor: pointer;
    }
    .redetermination-edit-button:hover { color: #003078; }
    .redetermination-edit-button:focus { color: #0b0c0c; }
  </style>
{% endblock %}

{% block beforeContent %}
  {{ govukPhaseBanner({ tag: { text: "Beta" }, html: 'This is a new service - your <a class="govuk-link" href="#">feedback</a> will help us to improve it.' }) }}
  {{ govukBackLink({ text: "Back" if assessmentOfNewProceedings else "Back to application", href: "/v6-v5/application/" ~ reference ~ "/redeterminations/decision" if assessmentOfNewProceedings else "/v6-v5/application/" ~ reference ~ "?isRedetermination=true" }) }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row"><div class="govuk-grid-column-two-thirds">
    {% if draft.errors.length %}{{ govukErrorSummary({ titleText: "There is a problem", errorList: draft.errors }) }}{% endif %}
    <p class="govuk-body-l govuk-!-margin-bottom-1">Application reference</p>
    <p class="govuk-heading-l">{{ reference }}</p>
    <h1 class="govuk-heading-xl">Make a decision</h1>
    <p class="govuk-body">Use this section to make decisions on one or more proceedings. Each decision will be recorded in application history and will be shared with the provider.</p>
    <form method="post" action="/v6-v5/application/{{ reference }}/redeterminations/{% if assessmentOfNewProceedings %}new-proceedings/{% endif %}decision">
      {% set appliedProceedingsHtml %}
      {% for request in requests %}
        <section class="govuk-!-margin-top-6 govuk-!-margin-bottom-8" aria-labelledby="request-heading-{{ request.index }}">
          <div class="redetermination-proceeding-heading">
            <h2 class="govuk-heading-m" id="request-heading-{{ request.index }}">Proceeding {{ request.index + 1 }}</h2>
            <button type="submit" class="govuk-body govuk-link redetermination-edit-button govuk-!-margin-bottom-5" formaction="/v6-v5/application/{{ reference }}/redeterminations/proceeding/{{ request.index }}/start-edit" formnovalidate>Change proceeding<span class="govuk-visually-hidden"> {{ request.index + 1 }}</span></button>
          </div>
          <p class="govuk-body">Details of request</p>
          <dl class="govuk-summary-list">
            <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Proceeding</dt><dd class="govuk-summary-list__value">{{ request.answer.proceedingName or request.redeterminationProceeding }}</dd></div>
            <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Client role</dt><dd class="govuk-summary-list__value">{{ request.answer.clientRole or request.redeterminationClientRole }}</dd></div>
            <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Scope limitations</dt><dd class="govuk-summary-list__value" style="white-space: pre-line;">{{ request.answer.scopeLimitations or request.scopeLimitations or 'Final Hearing\n\nTo be represented on all steps up to and including a final hearing.' }}</dd></div>
            <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Level of service</dt><dd class="govuk-summary-list__value">{{ request.answer.levelOfService or request.levelOfService or 'Full representation' }}</dd></div>
          </dl>
          {% set anotherGrantDateHtml %}
            {{ govukDateInput({
              id: "certificate-grant-date-" ~ request.index,
              namePrefix: "certificate-grant-date-" ~ request.index,
              fieldset: { legend: { text: "Enter date", classes: "govuk-fieldset__legend--s" } },
              hint: { text: "For example, 12 6 2026" },
              items: [
                { name: "day", value: request.answer.certificateGrantDateDay, classes: "govuk-input--width-2" },
                { name: "month", value: request.answer.certificateGrantDateMonth, classes: "govuk-input--width-2" },
                { name: "year", value: request.answer.certificateGrantDateYear, classes: "govuk-input--width-4" }
              ]
            }) }}
          {% endset %}
          {% set grantDateHtml %}
            {{ govukRadios({
              name: "certificate-grant-date-type-" ~ request.index,
              idPrefix: "certificate-grant-date-type-" ~ request.index,
              fieldset: { legend: { text: "When should the certificate be granted from?", classes: "govuk-fieldset__legend--s" } },
              items: [
                { value: "today", text: "Submitted date", checked: request.answer.certificateGrantDateType == "today" },
                { value: "another-date", text: "Another date", checked: request.answer.certificateGrantDateType == "another-date", conditional: { html: anotherGrantDateHtml } }
              ]
            }) }}
          {% endset %}
          {{ govukRadios({ name: "decision-" ~ request.index, idPrefix: "decision-" ~ request.index,
            fieldset: { legend: { text: "What is your decision", classes: "govuk-fieldset__legend--s" } },
            items: [
              { value: "grant", text: "Grant", checked: request.answer.decision == "grant", conditional: { html: grantDateHtml } },
              { value: "refuse", text: "Refuse", checked: request.answer.decision == "refuse",
                attributes: { "aria-controls": "grouped-explanation-container", "aria-expanded": showExplanation } }
            ] }) }}
        </section>
      {% endfor %}
      {% endset %}
      {{ appliedProceedingsHtml | safe }}
      <div id="grouped-explanation-container" class="govuk-radios__conditional{% if not showExplanation %} govuk-radios__conditional--hidden{% endif %}">
        {{ govukTextarea({ name: "grouped-explanation", id: "grouped-explanation", value: draft.explanation,
          label: { text: "Explain your decision", classes: "govuk-label--m" },
          hint: { text: "We will share this decision with the provider in the notification email. You will also find this saved in the application history." },
          errorMessage: draft.explanationError and { text: draft.explanationError } or null,
          attributes: { maxlength: 10000 } }) }}
        <p class="govuk-hint">You can enter up to 10,000 characters</p>
      </div>
      <div id="grouped-explanation-placeholder" hidden></div>
      {{ govukButton({ text: "Continue" }) }}
    </form>
  </div></div>
{% endblock %}

{% block bodyEnd %}
  {{ super() }}
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      var explanation = document.getElementById('grouped-explanation-container');
      var placeholder = document.getElementById('grouped-explanation-placeholder');
      if (!explanation) return;
      var refusalOptions = document.querySelectorAll('input[type="radio"][value="refuse"][name^="decision-"]');

      function updateExplanationVisibility() {
        var refusal = document.querySelector('input[type="radio"][name^="decision-"][value="refuse"]:checked');
        var showExplanation = Boolean(refusal);
        explanation.classList.toggle('govuk-radios__conditional--hidden', !showExplanation);
        refusalOptions.forEach(function (option) {
          option.setAttribute('aria-expanded', String(option === refusal));
        });
        if (refusal) {
          var decisionRadios = refusal.closest('.govuk-radios');
          if (decisionRadios) decisionRadios.insertAdjacentElement('afterend', explanation);
        } else if (placeholder) {
          placeholder.insertAdjacentElement('beforebegin', explanation);
        }
      }

      document.querySelectorAll('input[type="radio"][name^="decision-"]').forEach(function (decision) {
        decision.addEventListener('change', updateExplanationVisibility);
      });
      updateExplanationVisibility();
    });
  </script>
{% endblock %}
