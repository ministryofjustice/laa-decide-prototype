{% extends "v6-v5/redetermination-decision.njk" %}
{% block pageTitle %}Check your answers{% endblock %}
{% block beforeContent %}
  {{ govukPhaseBanner({ tag: { text: "Beta" }, html: 'This is a new service - your <a class="govuk-link" href="#">feedback</a> will help us to improve it.' }) }}
  {{ govukBackLink({
    text: "Back",
    href: "/v6-v5/application/" ~ reference ~ ("/redeterminations/new-proceedings/decision" if draft.proceedingMode == "new" else "/redeterminations/decision")
  }) }}
{% endblock %}

{% macro summaryCard(title, decision, role, scope, service, explanation, grantDate, grantDateType, changeHref, anchor, decisionHref, explanationHref, changeExplanation, originalProceeding, originalRole) %}
  {% set detailsHref = changeHref ~ anchor if anchor == "#additional-proceedings" else "/v6-v5/application/" ~ reference ~ "/redeterminations/proceeding/" ~ (anchor | replace('#request-heading-', '')) ~ "/edit?from=check-answers" %}
  {% set decisionTarget = (decisionHref or (changeHref ~ anchor)) | replace('#request-heading-', '#decision-') %}
  {% set dateTarget = decisionTarget | replace('#decision-', '#certificate-grant-date-type-') %}
  <div class="govuk-summary-card govuk-!-margin-bottom-6">
    <div class="govuk-summary-card__title-wrapper"><h2 class="govuk-summary-card__title">{{ title }}</h2></div>
    <div class="govuk-summary-card__content">
      <dl class="govuk-summary-list">
        <div class="govuk-summary-list__row">
          <dt class="govuk-summary-list__key">Decision</dt><dd class="govuk-summary-list__value">{{ decision }}</dd>
          <dd class="govuk-summary-list__actions"><a href="{{ decisionTarget }}" class="govuk-link">Change<span class="govuk-visually-hidden"> decision for {{ title }}</span></a></dd>
        </div>
        {% if decision == 'Grant' %}
          <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Date granted from</dt><dd class="govuk-summary-list__value">{{ grantDate }}</dd>
            <dd class="govuk-summary-list__actions"><a href="{{ dateTarget }}" class="govuk-link">Change<span class="govuk-visually-hidden"> date granted from for {{ title }}</span></a></dd>
          </div>
        {% endif %}
        <div class="govuk-summary-list__row">
          <dt class="govuk-summary-list__key">Proceeding</dt><dd class="govuk-summary-list__value">{{ title }}</dd>
          <dd class="govuk-summary-list__actions"><a href="{{ detailsHref if anchor == '#additional-proceedings' else detailsHref ~ '#proceeding-name' }}" class="govuk-link">Change<span class="govuk-visually-hidden"> proceeding {{ title }}</span></a></dd>
        </div>
        {% if changeExplanation %}
          <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Proceeding changed from</dt>
            <dd class="govuk-summary-list__value">{{ originalProceeding }}</dd>
          </div>
          <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Proceeding changed to</dt>
            <dd class="govuk-summary-list__value">{{ title }}</dd>
          </div>
          {% if originalRole != role %}
            <div class="govuk-summary-list__row">
              <dt class="govuk-summary-list__key">Client role changed from</dt>
              <dd class="govuk-summary-list__value">{{ originalRole }}</dd>
            </div>
          {% endif %}
          <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Reason for changing proceeding</dt>
            <dd class="govuk-summary-list__value" style="white-space: pre-line;">{{ changeExplanation }}</dd>
            <dd class="govuk-summary-list__actions"><a class="govuk-link" href="{{ detailsHref }}#change-explanation">Change<span class="govuk-visually-hidden"> reason for changing proceeding {{ title }}</span></a></dd>
          </div>
        {% endif %}
        <div class="govuk-summary-list__row">
          <dt class="govuk-summary-list__key">Client role</dt><dd class="govuk-summary-list__value">{{ role }}</dd>
          <dd class="govuk-summary-list__actions"><a href="{{ detailsHref if anchor == '#additional-proceedings' else detailsHref ~ '#client-role' }}" class="govuk-link">Change<span class="govuk-visually-hidden"> client role for {{ title }}</span></a></dd>
        </div>
        <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Scope limitations</dt><dd class="govuk-summary-list__value" style="white-space: pre-line;">{{ scope }}</dd></div>
        <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Level of service</dt><dd class="govuk-summary-list__value">{{ service }}</dd></div>
        {% if decision == 'Refuse' %}
          <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Decision reason</dt>
            <dd class="govuk-summary-list__value" style="white-space: pre-line;">{{ explanation }}</dd>
            <dd class="govuk-summary-list__actions"><a class="govuk-link" href="{{ explanationHref }}">Change<span class="govuk-visually-hidden"> decision reason for {{ title }}</span></a></dd>
          </div>
        {% endif %}
      </dl>
    </div>
  </div>
{% endmacro %}

{% block content %}
  {% set changeHref = "/v6-v5/application/" ~ reference ~ "/redeterminations/decision" %}
  {% set newDecisionHref = "/v6-v5/application/" ~ reference ~ "/redeterminations/new-proceedings/decision" %}
  <div class="govuk-grid-row"><div class="govuk-grid-column-two-thirds">
    <p class="govuk-body-l govuk-!-margin-bottom-1">Application reference</p>
    <p class="govuk-heading-l">{{ reference }}</p>
    <h1 class="govuk-heading-xl">Check your answers</h1>
    {% for item in decisions %}
      {{ summaryCard(item.proceedingName, "Grant" if item.decision == "grant" else "Refuse", item.clientRole,
        "Final Hearing\n\nTo be represented on all steps up to and including a final hearing.", "Full representation", item.explanation, item.certificateGrantDate, item.certificateGrantDateType, changeHref, "#request-heading-" ~ item.index, "", changeHref ~ "#explanation-" ~ item.index, item.changeExplanation, item.redeterminationProceeding, item.redeterminationClientRole) }}
    {% endfor %}
    {% for item in draft.additions %}
      {{ summaryCard(item.proceedingName, "Grant" if item.decision == "grant" else "Refuse", item.clientRole, item.scopeLimitations, item.levelOfService, item.explanation, item.certificateGrantDate, item.certificateGrantDateType, changeHref, "#additional-proceedings", newDecisionHref ~ "#request-heading-new-" ~ loop.index0, newDecisionHref ~ "#explanation-new-" ~ loop.index0) }}
    {% endfor %}
    <form method="post" action="/v6-v5/application/{{ reference }}/redeterminations/check-answers">{{ govukButton({ text: "Submit decision" }) }}</form>
  </div></div>
{% endblock %}