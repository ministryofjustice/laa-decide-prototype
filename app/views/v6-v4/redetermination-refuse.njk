{% extends "govuk/template.njk" %}

{% from "govuk/components/header/macro.njk" import govukHeader %}
{% from "govuk/components/phase-banner/macro.njk" import govukPhaseBanner %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/textarea/macro.njk" import govukTextarea %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "moj/components/primary-navigation/macro.njk" import mojPrimaryNavigation %}

{% block head %}<link href="/public/stylesheets/application.css" rel="stylesheet">{% endblock %}
{% block pageTitle %}Make a decision{% endblock %}

{% block header %}
  {{ govukHeader({ homepageUrl: "#", productName: "Legal Aid Agency", navigationClasses: "govuk-header__navigation--end", navigation: [{ href: "#", text: "joann.barton@justice.gov.uk" }, { href: "/v6-v4/sign-out", text: "Sign out" }] }) }}
  {{ mojPrimaryNavigation({ label: "Primary navigation", items: [{ text: "Decide if an applicant can get legal aid", href: "#" }, { text: "Open applications", href: "/v6-v4/open-applications" }, { text: "Your list", href: "/v6-v4/yourlist" }, { text: "Search", href: "/v6-v4/search" }] }) }}
{% endblock %}

{% block beforeContent %}
  {{ govukPhaseBanner({ tag: { text: "Beta" }, html: "This is a new service - your <a class=\"govuk-link\" href=\"#\">feedback</a> will help us to improve it." }) }}
  {{ govukBackLink({ text: "Back to application", href: "/v6-v4/application/" ~ reference ~ "?isRedetermination=true&redeterminationIndex=" ~ index }) }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row"><div class="govuk-grid-column-two-thirds">
    {% if errors.refusalReason and errors.decisionReason %}
      {{ govukErrorSummary({ titleText: "There is a problem", errorList: [{ text: errors.refusalReason, href: "#refusal-reason" }, { text: errors.decisionReason, href: "#decision-reason" }] }) }}
    {% elif errors.refusalReason %}
      {{ govukErrorSummary({ titleText: "There is a problem", errorList: [{ text: errors.refusalReason, href: "#refusal-reason" }] }) }}
    {% elif errors.decisionReason %}
      {{ govukErrorSummary({ titleText: "There is a problem", errorList: [{ text: errors.decisionReason, href: "#decision-reason" }] }) }}
    {% endif %}

    <p class="govuk-body-l govuk-!-margin-bottom-1">Application reference</p>
    <p class="govuk-heading-l govuk-!-margin-bottom-4">{{ reference }}</p>
    <h1 class="govuk-heading-xl govuk-!-margin-bottom-6">Select a reason for refusal</h1>

    <form action="/v6-v4/application/{{ reference }}/redetermination/{{ index }}/refuse" method="post">
      {{ govukRadios({
        name: "refusal-reason",
        idPrefix: "refusal-reason",
        errorMessage: errors.refusalReason and { text: errors.refusalReason } or null,
        items: [
          { value: "Not in scope", text: "Not in scope", checked: refusalReason == "Not in scope" },
          { value: "Insufficient Information", text: "Insufficient Information", checked: refusalReason == "Insufficient Information" },
          { value: "Duplicate Case", text: "Duplicate Case", checked: refusalReason == "Duplicate Case" }
        ]
      }) }}
      {{ govukTextarea({
        name: "decision-reason",
        id: "decision-reason",
        value: decisionReason,
        label: { text: "Explain your decision", classes: "govuk-label--m" },
        hint: { text: "We will share this decision with the provider in the notification email. You will also find it saved in the application history." },
        errorMessage: errors.decisionReason and { text: errors.decisionReason } or null
      }) }}
      {{ govukButton({ text: "Continue" }) }}
    </form>
  </div></div>
{% endblock %}

{% block bodyEnd %}
  <script src="/plugin-assets/govuk-prototype-kit/lib/assets/javascripts/kit.js"></script>
  <script src="/plugin-assets/govuk-prototype-kit/lib/assets/javascripts/auto-store-data.js"></script>
  <script type="module" src="/plugin-assets/govuk-frontend/dist/govuk/govuk-frontend.min.js"></script>
  <script type="module" src="/plugin-assets/govuk-frontend/dist/govuk-prototype-kit/init.js"></script>
{% endblock %}