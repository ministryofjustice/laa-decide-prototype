{% extends "govuk/template.njk" %}

{% from "govuk/components/header/macro.njk" import govukHeader %}
{% from "govuk/components/phase-banner/macro.njk" import govukPhaseBanner %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "moj/components/primary-navigation/macro.njk" import mojPrimaryNavigation %}

{% block pageTitle %}Confirm unlink case{% endblock %}

{% block head %}
  <link href="/public/stylesheets/application.css" rel="stylesheet">
  <style>
    .unlink-case-table { width: 100%; table-layout: fixed; }
    .unlink-case-table th, .unlink-case-table td { padding-left: 8px; padding-right: 8px; }
    .unlink-case-table td:nth-child(2), .unlink-case-table td:nth-child(6) { white-space: nowrap; }
    .unlink-case-justification { width: 100%; max-width: 610px; }
  </style>
{% endblock %}

{% block header %}
  {{ govukHeader({
    homepageUrl: "#",
    productName: "Legal Aid Agency",
    navigationClasses: "govuk-header__navigation--end",
    navigation: [
      { href: '#', text: "jonaan.barton@law.com" },
      { href: '/v6/sign-out', text: "Sign out" }
    ]
  }) }}
  {{ mojPrimaryNavigation({
    label: 'Primary navigation',
    items: [
      { text: 'Decide if an applicant can get legal aid', href: '#' },
      { text: 'Open applications', href: '/v6/open-applications' },
      { text: 'Your list', href: '/v6/yourlist' },
      { text: 'Search', href: '/v6/search' }
    ]
  }) }}
{% endblock %}

{% block beforeContent %}
  {{ govukPhaseBanner({ tag: { text: "Beta" }, html: 'This is a new service - your <a class="govuk-link" href="#">feedback</a> will help us to improve it.' }) }}
  {{ govukBackLink({ text: "Back", href: "/v6/manage-linked-cases/" ~ reference }) }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <h1 class="govuk-heading-xl">Are you sure you want to unlink this case</h1>
      <p class="govuk-body">This application will now be a standalone case. When unlinked, it will be assigned its own cost limit.</p>

      <table class="govuk-table unlink-case-table">
        <thead class="govuk-table__head">
          <tr class="govuk-table__row">
            <th scope="col" class="govuk-table__header">Reference</th>
            <th scope="col" class="govuk-table__header">Submitted</th>
            <th scope="col" class="govuk-table__header">Type</th>
            <th scope="col" class="govuk-table__header">Delegated Functions</th>
            <th scope="col" class="govuk-table__header">Matter type</th>
            <th scope="col" class="govuk-table__header">Status</th>
          </tr>
        </thead>
        <tbody class="govuk-table__body">
          <tr class="govuk-table__row">
            <td class="govuk-table__cell"><a href="/v6/application/{{ application.ref }}" class="govuk-link">{{ application.ref }}</a></td>
            <td class="govuk-table__cell">{{ application.submitted }}</td>
            <td class="govuk-table__cell">{{ application.type or 'Initial application' }}</td>
            <td class="govuk-table__cell">{{ application.delegatedFunctions or 'Used' }}</td>
            <td class="govuk-table__cell"><strong>{{ application.matterType.title if application.matterType else 'Family' }}</strong><br>{{ application.matterType.subtext if application.matterType else "Special Children's Act" }}</td>
            <td class="govuk-table__cell"><span class="govuk-tag govuk-tag--light-blue">In progress</span></td>
          </tr>
        </tbody>
      </table>

      <h2 class="govuk-heading-s govuk-!-margin-top-6">Explain your decision</h2>
      <p class="govuk-body">This information is for internal use only and will not be shared with the provider.</p>
      <form action="/v6/confirm-unlink-case/{{ reference }}" method="post">
        <textarea class="govuk-textarea unlink-case-justification" name="unlink-justification" rows="5"></textarea>
        <div class="govuk-button-group govuk-!-margin-top-4">
          {{ govukButton({ text: "Unlink case" }) }}
          <a href="/v6/manage-linked-cases/{{ reference }}" class="govuk-link">Cancel</a>
        </div>
      </form>
    </div>
  </div>
{% endblock %}
