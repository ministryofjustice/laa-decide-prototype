{% extends "govuk/template.njk" %}

{% from "govuk/components/header/macro.njk" import govukHeader %}
{% from "govuk/components/phase-banner/macro.njk" import govukPhaseBanner %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "moj/components/primary-navigation/macro.njk" import mojPrimaryNavigation %}

{% block pageTitle %}Select the lead case{% endblock %}

{% block head %}
  <link href="/public/stylesheets/application.css" rel="stylesheet">
  <style>
    .select-lead-case-table .govuk-table__cell:nth-child(2) {
      white-space: nowrap;
    }
    .select-lead-case-table .govuk-table__cell:last-child {
      white-space: nowrap;
    }
    .select-lead-case-table {
      width: 100%;
      table-layout: fixed;
    }
    .select-lead-case-table th,
    .select-lead-case-table td {
      padding-left: 10px;
      padding-right: 10px;
    }
    .select-lead-case-table th:nth-child(1),
    .select-lead-case-table td:nth-child(1) { width: 17%; }
    .select-lead-case-table th:nth-child(2),
    .select-lead-case-table td:nth-child(2) { width: 14%; }
    .select-lead-case-table th:nth-child(3),
    .select-lead-case-table td:nth-child(3) { width: 17%; }
    .select-lead-case-table th:nth-child(4),
    .select-lead-case-table td:nth-child(4) { width: 17%; }
    .select-lead-case-table th:nth-child(5),
    .select-lead-case-table td:nth-child(5) { width: 23%; }
    .select-lead-case-table th:nth-child(6),
    .select-lead-case-table td:nth-child(6) { width: 12%; }
    .select-lead-case-table .govuk-radios {
      margin: 0;
    }
  </style>
{% endblock %}

{% block header %}
  {{ govukHeader({
    homepageUrl: "#",
    productName: "Legal Aid Agency",
    navigationClasses: "govuk-header__navigation--end",
    navigation: [
      { href: '#', text: "jonaan.barton@law.com" },
      { href: '/v6/sign-out', text: "Sign out" }
    ]
  }) }}
  {{ mojPrimaryNavigation({
    label: 'Primary navigation',
    items: [
      { text: 'Decide if an applicant can get legal aid', href: '#' },
      { text: 'Open applications', href: '/v6/open-applications' },
      { text: 'Your list', href: '/v6/yourlist' },
      { text: 'Search', href: '/v6/search' }
    ]
  }) }}
{% endblock %}

{% block beforeContent %}
  {{ govukPhaseBanner({ tag: { text: "Beta" }, html: 'This is a new service - your <a class="govuk-link" href="#">feedback</a> will help us to improve it.' }) }}
  {{ govukBackLink({ text: "Back", href: "/v6/search?linkToReference=" ~ reference }) }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <h1 class="govuk-heading-xl">Select the lead case</h1>
      <p class="govuk-body">We will assign the full cost limit to the lead case. All other associated cases will be assigned a £0.00 cost limit.</p>

      <form action="/v6/select-lead-case" method="post">
        <input type="hidden" name="reference" value="{{ reference }}">
        <input type="hidden" name="linkedReference" value="{{ linkedReference }}">
        <table class="govuk-table select-lead-case-table">
          <thead class="govuk-table__head">
            <tr class="govuk-table__row">
              <th scope="col" class="govuk-table__header">Reference</th>
              <th scope="col" class="govuk-table__header">Submitted</th>
              <th scope="col" class="govuk-table__header">Type</th>
              <th scope="col" class="govuk-table__header">Delegated Functions</th>
              <th scope="col" class="govuk-table__header">Matter type</th>
              <th scope="col" class="govuk-table__header">Status</th>
            </tr>
          </thead>
          <tbody class="govuk-table__body">
            {% for application in applications %}
              <tr class="govuk-table__row">
                <td class="govuk-table__cell">
                  {{ govukRadios({
                    idPrefix: "lead-" ~ loop.index,
                    name: "leadReference",
                    classes: "govuk-radios--small",
                    items: [{
                      value: application.ref,
                      html: '<a href="/v6/application/' ~ application.ref ~ '" class="govuk-link">' ~ application.ref ~ '</a>',
                      checked: application.ref == leadReference
                    }]
                  }) }}
                </td>
                <td class="govuk-table__cell">{{ application.submitted or 'Not available' }}</td>
                <td class="govuk-table__cell">{{ application.type or 'Initial application' }}</td>
                <td class="govuk-table__cell">{{ application.delegatedFunctions or 'Used' }}</td>
                <td class="govuk-table__cell"><strong>{{ application.matterType.title if application.matterType else 'Family' }}</strong><br>{{ application.matterType.subtext if application.matterType else "Special Children's Act" }}</td>
                <td class="govuk-table__cell"><span class="govuk-tag govuk-tag--light-blue">In progress</span></td>
              </tr>
            {% endfor %}
          </tbody>
        </table>

        {{ govukButton({ text: "Continue" }) }}
        <a href="/v6/search?linkToReference={{ reference }}" class="govuk-link govuk-!-margin-left-3">Cancel</a>
      </form>
    </div>
  </div>
{% endblock %}
